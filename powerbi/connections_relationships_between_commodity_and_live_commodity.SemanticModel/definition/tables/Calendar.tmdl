	measure 'Conflict Delta Text' = ```
			VAR Days = DISTINCTCOUNT('commodity_prices'[Date])
			RETURN
			IF(Days = 0, "no data", "about " & FORMAT(DIVIDE([Total Conflict Keywords], Days), "0.0") & " per day")
			```
		lineageTag: bf6cbf86-dc11-5604-9c75-18e0db78e5d5
	measure 'Last Price Update' = ```
			VAR T = CALCULATE(MAX('live_commodity_prices'[timestamp]), ALL('Calendar'))
			RETURN
			FORMAT(T, "d MMM yyyy") & "  ·  " & FORMAT(T, "HH:mm") & " UTC"
			```
		lineageTag: 61cbeb85-2d20-5f20-a723-ed71bebfd545
	measure 'Conflict Events' = ```
			COUNTROWS('conflict_events')
			```
		lineageTag: 2bb89a5e-962b-597e-9868-1e5f0901c8b4
		formatString: #,##0
	measure 'Avg Severity' = ```
			-AVERAGE('conflict_events'[goldstein_scale])
			```
		lineageTag: f0561793-d6e6-57d1-b841-aa5961e596f0
		formatString: 0.0
	measure 'Media Mentions' = ```
			SUM('conflict_events'[num_mentions])
			```
		lineageTag: 21ebeda9-1763-5580-b34b-10236dd65fb8
		formatString: #,##0
	measure 'Top Hotspot' = ```
			VAR T = TOPN(1, VALUES('conflict_events'[hotspot_region]), [Conflict Events], DESC)
			RETURN
			IF(ISEMPTY(T), "n/a", MAXX(T, 'conflict_events'[hotspot_region]))
			```
		lineageTag: 3bc4c576-8af8-5cbd-99dd-763c0d694e74
	measure 'Events Delta Text' = ```
			VAR Days = DISTINCTCOUNT('conflict_events'[Date])
			VAR Regions = DISTINCTCOUNT('conflict_events'[hotspot_region])
			RETURN
			IF(Days = 0, "no events in range", "about " & FORMAT(DIVIDE([Conflict Events], Days), "#,##0") & " a day in " & Regions & " hotspot regions")
			```
		lineageTag: beb9ac96-a429-54ab-80d7-3a9b58e83568
	measure 'Severity Delta Text' = ```
			"Goldstein scale, 10 = most severe"
			```
		lineageTag: 1d5a8055-6ca7-544b-9699-d315a0a269d0
	measure 'Top Hotspot Delta Text' = ```
			VAR TopName = [Top Hotspot]
			RETURN
			IF(ISBLANK([Conflict Events]), "no events in range", FORMAT(DIVIDE(CALCULATE([Conflict Events], 'conflict_events'[hotspot_region] = TopName), [Conflict Events]), "0%") & " of all events")
			```
		lineageTag: 18e5b376-35e5-53bc-8beb-dcb9a3d74497
	measure 'Mentions Delta Text' = ```
			IF(ISBLANK([Conflict Events]), "no events in range", "about " & FORMAT(DIVIDE([Media Mentions], [Conflict Events]), "0.0") & " mentions per event")
			```
		lineageTag: 3b551bef-727a-525d-b1b9-fdf7b1e48b48
	measure 'Headline Count' = ```
			COUNTROWS('headline_log')
			```
