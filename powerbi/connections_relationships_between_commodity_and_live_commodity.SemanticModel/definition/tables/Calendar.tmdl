	measure 'Gold Delta Text' = ```
			VAR LatestT = CALCULATE(MAX('live_commodity_prices'[timestamp]), NOT ISBLANK('live_commodity_prices'[gold_usd_oz]))
			VAR Latest = CALCULATE(MAX('live_commodity_prices'[gold_usd_oz]), 'live_commodity_prices'[timestamp] = LatestT)
			VAR PriorT = CALCULATE(MAX('live_commodity_prices'[timestamp]), ALL('Calendar'), 'live_commodity_prices'[timestamp] <= LatestT - 7, NOT ISBLANK('live_commodity_prices'[gold_usd_oz]))
			VAR Prior = CALCULATE(MAX('live_commodity_prices'[gold_usd_oz]), ALL('Calendar'), 'live_commodity_prices'[timestamp] = PriorT)
			VAR Chg = DIVIDE(Latest - Prior, Prior)
			RETURN
			IF(ISBLANK(Chg), "no 7-day history yet",
			    IF(Chg >= 0, UNICHAR(9650), UNICHAR(9660)) & " " & FORMAT(ABS(Chg), "0.0%") & " vs 7 days ago")
			```
		lineageTag: de0049d1-7001-5260-9147-fa3e2fc26b6c
