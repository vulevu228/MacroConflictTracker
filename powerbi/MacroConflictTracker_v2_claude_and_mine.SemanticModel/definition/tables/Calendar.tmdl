	column Date
		formatString: General Date
		lineageTag: 7240c199-a9ba-4f40-8b73-f5fd7c9a326c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: 53513137-8b6d-4ce5-aac9-cb91951ac945
			defaultHierarchy: LocalDateTable_e55ebe35-8912-420d-a18c-b5ac272338bf.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				
				VAR MinDate = MIN(MIN('commodity_prices'[timestamp]), MIN('live_commodity_prices'[timestamp]))
				VAR MaxDate = MAX(MAX('commodity_prices'[timestamp]), MAX('live_commodity_prices'[timestamp]))
				RETURN
				CALENDAR(DATEVALUE(MinDate), DATEVALUE(MaxDate)) 
				```

	annotation PBI_Id = 16f586667ab04dc7815121c85222794c

