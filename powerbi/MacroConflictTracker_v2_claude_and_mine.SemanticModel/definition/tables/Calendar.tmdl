table Calendar
	lineageTag: 5688752f-af2f-4459-83d9-38dc5616b44f

	measure 'Current Gold Price' =
			VAR LatestTimeWithData =
			    CALCULATE(MAX('live_commodity_prices'[timestamp]), NOT ISBLANK('live_commodity_prices'[gold_usd_oz]))
			RETURN
			CALCULATE(MAX('live_commodity_prices'[gold_usd_oz]), 'live_commodity_prices'[timestamp] = LatestTimeWithData)
		formatString: \$#,##0.00
		lineageTag: 018205a1-3b9e-43e0-a5cc-03d6bd8da9fb

